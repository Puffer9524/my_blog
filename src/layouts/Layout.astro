---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import ProfileCard from '../components/ProfileCard.astro';
import CategoryCard from '../components/CategoryCard.astro';

export interface Props {
  title?: string;
  description?: string;
  showSideCards?: boolean;
}

const { title, description, showSideCards = true } = Astro.props;
const hasRightSidebar = Astro.slots['right-sidebar'] != null;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | PufferSite` : 'PufferSite'}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Navbar />

    <div
      class="page-wrapper"
      class:list={{ 'has-right-sidebar': hasRightSidebar }}
    >
      {showSideCards && (
        <aside class="page-sidebar">
          <ProfileCard />
          <CategoryCard />
        </aside>
      )}

      <div class="page-content">
        <slot />
      </div>

      {hasRightSidebar && (
        <aside class="page-right-sidebar">
          {Astro.slots['right-sidebar'] != null && <slot name="right-sidebar" />}
        </aside>
      )}
    </div>
  </body>
</html>
