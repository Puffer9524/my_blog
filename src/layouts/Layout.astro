---
import '../styles/global.css';
import '../styles/prose.css';
import Navbar from '../components/Navbar.astro';
import ProfileCard from '../components/ProfileCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TagCard from '../components/TagCard.astro';
import HomeCover from '../components/HomeCover.astro';
import HeroIntro from '../components/HeroIntro.astro';
import ImageLightbox from '../components/common/ImageLightbox.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { siteConfig } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  showSideCards?: boolean;
  homeIntro?: boolean;
}

const {
  title,
  description,
  showSideCards = true,
  homeIntro = false,
} = Astro.props;
const hasRightSidebar = Astro.slots['right-sidebar'] != null;
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const mode = localStorage.getItem('theme-mode') || 'system';
          const theme = mode === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : mode;

          document.documentElement.dataset.themeMode = mode;
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.backgroundColor = theme === 'dark' ? '#0f172a' : '#f3f4f6';
        } catch {
          const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
          document.documentElement.style.backgroundColor = isDark ? '#0f172a' : '#f3f4f6';
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | ${siteConfig.name}` : siteConfig.name}</title>
    <meta name="description" content={description ?? siteConfig.description} />
  </head>
  <body>
    <Navbar />
    {homeIntro ? <HeroIntro /> : <HomeCover />}

    <div class:list={['page-wrapper-outer', { 'with-home-intro': homeIntro }]}>
      <div
        class="page-wrapper"
        class:list={{
          'has-right-sidebar': hasRightSidebar,
          'with-home-cover': !homeIntro,
        }}
      >
        {showSideCards && (
          <aside class="page-sidebar">
            <ProfileCard />
            <CategoryCard />
            <TagCard />
          </aside>
        )}

        <div class="page-content">
          <slot />
        </div>

        {hasRightSidebar && (
          <aside class="page-right-sidebar">
            {Astro.slots['right-sidebar'] != null && <slot name="right-sidebar" />}
          </aside>
        )}
      </div>
    </div>
    <ImageLightbox />
    <SiteSearch />
  </body>
</html>
