---
import { getTagHref } from '../utils/tags';

interface Props {
  tags: string[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---

{tags.length > 0 && (
  <nav class="article-tags" aria-label="文章标签">
    {Array.from(new Set(tags)).map((tag) => (
      <a
        class="article-tag"
        href={getTagHref(tag)}
        aria-current={tag === activeTag ? 'page' : undefined}
        aria-label={`查看标签 ${tag} 下的文章`}
        rel="tag"
      >#{tag}</a>
    ))}
  </nav>
)}

<style>
  .article-tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    width: fit-content;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 2px 9px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-secondary);
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
  }

  .article-tag:hover,
  .article-tag[aria-current='page'] {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .article-tag:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-tag { transition: none; }
  }
</style>
