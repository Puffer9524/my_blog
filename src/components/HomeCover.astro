---
import { siteConfig } from '../config/site';

const { image, alt, position } = siteConfig.homeCover;
---

<section class="home-cover" id="home-cover">
  <button class="cover-button" id="cover-button" aria-label="查看完整封面图片">
    <img
      class="cover-image"
      id="cover-image"
      src={image}
      alt={alt}
      style={`object-position: ${position}`}
      fetchpriority="high"
    />
    <span class="cover-hint">点击查看完整图片</span>
  </button>
</section>

<div class="cover-lightbox" id="cover-lightbox" aria-hidden="true">
  <button class="lightbox-close" id="cover-lightbox-close" aria-label="关闭封面预览">&times;</button>
  <img src={image} alt={alt} />
</div>

<style>
  .home-cover {
    position: relative;
    height: clamp(300px, 44vw, 470px);
    overflow: hidden;
    background: var(--color-bg);
  }

  .cover-button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: calc(100% + 70px);
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translate3d(0, var(--cover-offset, 0), 0) scale(1.02);
    will-change: transform;
  }

  .cover-button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, rgba(2, 6, 23, 0.38));
  }

  .cover-hint {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 88px;
    padding: 6px 10px;
    border-radius: 50px;
    color: #fff;
    background: rgba(2, 6, 23, 0.48);
    backdrop-filter: blur(8px);
    font-size: 12px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .cover-button:hover .cover-hint,
  .cover-button:focus-visible .cover-hint {
    opacity: 1;
  }

  .cover-lightbox {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s, visibility 0.25s;
  }

  .cover-lightbox.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cover-lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    font-size: 28px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .home-cover {
      height: 300px;
    }

    .cover-hint {
      display: none;
    }

    .cover-lightbox {
      padding: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-image {
      transform: none;
    }
  }
</style>

<script>
  const cover = document.getElementById('home-cover');
  const coverImage = document.getElementById('cover-image');
  const coverButton = document.getElementById('cover-button');
  const lightbox = document.getElementById('cover-lightbox');
  const closeButton = document.getElementById('cover-lightbox-close');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function updateCoverPosition() {
    if (!cover || !coverImage || reduceMotion.matches) return;
    const offset = Math.min(window.scrollY * 0.22, 70);
    coverImage.style.setProperty('--cover-offset', `${offset}px`);
  }

  function openLightbox() {
    lightbox?.classList.add('open');
    lightbox?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  coverButton?.addEventListener('click', openLightbox);
  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
  window.addEventListener('scroll', updateCoverPosition, { passive: true });
  updateCoverPosition();
</script>
