---
interface Props {
  href: '/' | '/archive' | '/life' | '/friends' | '/about';
}

const { href } = Astro.props;
---

<svg
  class="navigation-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {href === '/' && (
    <>
      <path d="m3 11 9-8 9 8" />
      <path d="M5 10v10h14V10" />
      <path d="M9 20v-6h6v6" />
    </>
  )}

  {href === '/archive' && (
    <>
      <rect x="3" y="4" width="18" height="5" rx="1.5" />
      <path d="M5 9v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 13h6" />
    </>
  )}

  {href === '/life' && (
    <>
      <path d="M12 21s-7-4.4-7-11a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 6.6-7 11-7 11Z" />
      <path d="M8.5 13h2l1-2 1.5 4 1-2h1.5" />
    </>
  )}

  {href === '/friends' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 20v-1.5A4.5 4.5 0 0 1 8 14h2a4.5 4.5 0 0 1 4.5 4.5V20" />
      <circle cx="17" cy="9" r="2.5" />
      <path d="M15.5 14.5h1.8a3.7 3.7 0 0 1 3.7 3.7V20" />
    </>
  )}

  {href === '/about' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v6" />
      <path d="M12 7.5h.01" />
    </>
  )}
</svg>

<style>
  .navigation-icon {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
  }
</style>
