---
import { siteConfig } from '../config/site';
import { contactAccounts, socialLinks } from '../data/social-links';

export interface Props {
  avatar?: string;
  name?: string;
  bio?: string;
  signature?: string;
}

const {
  avatar = siteConfig.author.avatar,
  name = siteConfig.author.name,
  bio = siteConfig.author.bio,
  signature = siteConfig.author.signature,
} = Astro.props;
---

<div class="profile-card card">
  <div class="avatar-wrapper">
    <img
      src={avatar}
      alt={`${name}'s avatar`}
      class="avatar"
      width="160"
      height="160"
      loading="lazy"
    />
  </div>

  <h2 class="name">{name}</h2>
  <p class="bio">{bio}</p>

  {
    socialLinks.length > 0 && (
      <div class="social-row">
        {socialLinks.map((link) => {
          const icon = (
            <svg
              class="social-icon"
              viewBox="0 0 24 24"
              role="img"
              aria-hidden="true"
            >
              {link.iconPath ? (
                <path d={link.iconPath} />
              ) : (
                <text class="social-icon-text" x="12" y="14.5" text-anchor="middle">
                  {link.iconText}
                </text>
              )}
            </svg>
          );

          return link.url ? (
            <a
              href={link.url}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              title={link.label}
              aria-label={link.label}
              style={`--brand-color: ${link.color}`}
            >
              {icon}
            </a>
          ) : (
            <span
              class="contact-popover"
            >
              <span
                class="social-link social-link-static"
                aria-label="查看 QQ 和微信账号"
                style={`--brand-color: ${link.color}`}
              >
                {icon}
              </span>

              <span class="contact-card" role="tooltip">
                <span class="contact-row">
                  <svg class="contact-logo qq-logo" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={link.iconPath} />
                  </svg>
                  <span class="contact-details">
                    <span class="contact-label">QQ</span>
                    <span class="contact-value">{contactAccounts.qq}</span>
                  </span>
                </span>

                <span class="contact-row">
                  <svg class="contact-logo wechat-logo" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8.55 3.5C4.38 3.5 1 6.4 1 9.98c0 2.04 1.1 3.86 2.82 5.05l-.71 2.14 2.5-1.25c.92.34 1.91.53 2.94.53.26 0 .51-.01.76-.04a5.7 5.7 0 0 1-.27-1.72c0-3.5 3.1-6.34 6.93-6.34h.08C15.2 5.56 12.18 3.5 8.55 3.5Zm-2.5 4.03a.94.94 0 1 1 0-1.88.94.94 0 0 1 0 1.88Zm5.03 0a.94.94 0 1 1 0-1.88.94.94 0 0 1 0 1.88ZM23 14.69c0-2.96-2.82-5.36-6.3-5.36-3.48 0-6.3 2.4-6.3 5.36s2.82 5.36 6.3 5.36c.86 0 1.68-.15 2.43-.43l2.08 1.04-.59-1.78C22.06 17.9 23 16.38 23 14.69Zm-8.4-2.02a.78.78 0 1 1 0-1.56.78.78 0 0 1 0 1.56Zm4.2 0a.78.78 0 1 1 0-1.56.78.78 0 0 1 0 1.56Z" />
                  </svg>
                  <span class="contact-details">
                    <span class="contact-label">WeChat</span>
                    <span class="contact-value">{contactAccounts.wechat}</span>
                  </span>
                </span>
              </span>
            </span>
          );
        })}
      </div>
    )
  }

  <p class="signature">{signature}</p>
</div>

<style>
  .profile-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .avatar-wrapper {
    width: 100%;
    margin-bottom: 4px;
  }

  .avatar {
    width: 100%;
    height: auto;
    max-height: 320px;
    border-radius: var(--radius-md);
    object-fit: contain;
    border: 1px solid var(--color-border);
    display: block;
    background: var(--color-bg);
  }

  .name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bio {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 200px;
  }

  .social-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .social-link:hover {
    background-color: var(--color-bg-hover);
    border-color: var(--brand-color, var(--color-border));
    transform: translateY(-2px);
  }

  .social-link-static {
    cursor: help;
  }

  .contact-popover {
    position: relative;
    display: flex;
    outline: none;
  }

  .contact-card {
    position: absolute;
    z-index: 20;
    left: 50%;
    bottom: calc(100% + 12px);
    width: max-content;
    min-width: 180px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card-hover);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 6px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }

  .contact-card::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: var(--color-bg-card);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transform: translateX(-50%) rotate(45deg);
  }

  .contact-popover:hover .contact-card {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 9px;
    text-align: left;
  }

  .contact-row + .contact-row {
    margin-top: 9px;
    padding-top: 9px;
    border-top: 1px solid var(--color-divider);
  }

  .contact-logo {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  .qq-logo {
    fill: #12b7f5;
  }

  .wechat-logo {
    fill: #07c160;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .contact-label {
    color: var(--color-text-muted);
    font-size: 11px;
  }

  .contact-value {
    color: var(--color-text);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .social-icon {
    width: 18px;
    height: 18px;
    fill: var(--color-text-secondary);
    transition: fill 0.2s;
  }

  .social-link:hover .social-icon {
    fill: var(--brand-color);
  }

  :global([data-theme='dark']) .social-link:hover {
    border-color: var(--color-accent);
  }

  :global([data-theme='dark']) .social-link:hover .social-icon {
    fill: var(--color-accent);
  }

  .social-icon-text {
    font-size: 6px;
    font-weight: 800;
    fill: inherit;
  }

  .signature {
    font-size: 12px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .avatar-wrapper {
      width: min(100%, 280px);
    }

    .avatar {
      max-height: 280px;
    }

    .name {
      font-size: 18px;
    }
  }
</style>
