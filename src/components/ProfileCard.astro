---
import { siteConfig } from '../config/site';
import { socialLinks } from '../data/social-links';

export interface Props {
  avatar?: string;
  name?: string;
  bio?: string;
  signature?: string;
}

const {
  avatar = siteConfig.author.avatar,
  name = siteConfig.author.name,
  bio = siteConfig.author.bio,
  signature = siteConfig.author.signature,
} = Astro.props;
---

<div class="profile-card card">
  <div class="avatar-wrapper">
    <img
      src={avatar}
      alt={`${name}'s avatar`}
      class="avatar"
      width="160"
      height="160"
      loading="lazy"
    />
  </div>

  <h2 class="name">{name}</h2>
  <p class="bio">{bio}</p>

  {
    socialLinks.length > 0 && (
      <div class="social-row">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            title={link.label}
            aria-label={link.label}
          >
            <span class="social-icon">{link.icon}</span>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    )
  }

  <p class="signature">{signature}</p>
</div>

<style>
  .profile-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .avatar-wrapper {
    margin-bottom: 4px;
  }

  .avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-border);
    display: block;
  }

  .name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bio {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 200px;
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 50px;
    border: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: background-color 0.2s, color 0.2s;
  }

  .social-link:hover {
    background-color: var(--color-bg-hover);
    color: var(--color-text);
  }

  .social-icon {
    font-size: 15px;
  }

  .signature {
    font-size: 12px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .avatar {
      width: 80px;
      height: 80px;
    }

    .name {
      font-size: 18px;
    }
  }
</style>
