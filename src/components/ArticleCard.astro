---
import type { CollectionEntry } from 'astro:content';
import { postCategoryLabels } from '../config/categories';
import { formatDate } from '../utils/date';
import { getPostSlug } from '../utils/posts';

export interface Props {
  post: CollectionEntry<'posts'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, description, cover, coverAlt, date, category, tags } = post.data;
const slug = getPostSlug(post);
const formattedDate = formatDate(date);
const coverSrc = cover ?? '/home-cover.svg';
---

<article class:list={['article-card', 'card', { compact }]}>
  <a href={`/posts/${slug}`} class="article-link">
    <div class="article-content">
      <div class="article-meta">
        <time class="article-date" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {category && (
          <span class="article-category">
            {postCategoryLabels[category]}
          </span>
        )}
      </div>

      <h2 class="article-title">{title}</h2>

      {description && (
        <p class="article-desc">{description}</p>
      )}

      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <figure class="article-cover">
      <img
        src={coverSrc}
        alt={coverAlt ?? `${title}封面`}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </a>
</article>

<style>
  .article-card {
    padding: 0;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .article-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }

  .article-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 22px;
    align-items: stretch;
    min-height: 170px;
    padding: 16px;
  }

  .article-content {
    display: flex;
    min-width: 0;
    padding: 5px 8px;
    flex-direction: column;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .article-date {
    color: var(--color-text-muted);
  }

  .article-category {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 2px 10px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 500;
  }

  .article-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 6px;
    transition: color 0.2s;
  }

  .article-card:hover .article-title {
    color: var(--color-accent);
  }

  .article-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tag {
    font-size: 12px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .tag:hover {
    color: var(--color-text-secondary);
  }

  .article-cover {
    position: relative;
    min-height: 138px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-hover);
  }

  .article-cover::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-cover img {
    transform: scale(1.04);
  }

  .article-card.compact {
    height: 100%;
  }

  .compact .article-link {
    height: 100%;
    grid-template-columns: 1fr;
    grid-template-rows: 112px 1fr;
    gap: 10px;
    padding: 10px;
  }

  .compact .article-content {
    grid-row: 2;
    padding: 2px 4px 4px;
  }

  .compact .article-cover {
    grid-row: 1;
    min-height: 112px;
  }

  .compact .article-meta {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 10px;
    font-size: 11px;
  }

  .compact .article-category {
    padding: 1px 7px;
    font-size: 10px;
  }

  .compact .article-title {
    font-size: 14px;
    margin-bottom: 6px;
  }

  .compact .article-desc {
    font-size: 11px;
    line-height: 1.5;
    margin-bottom: 9px;
  }

  .compact .article-tags {
    gap: 4px;
  }

  .compact .tag {
    font-size: 10px;
  }

  @media (max-width: 640px) {
    .article-link {
      grid-template-columns: 1fr;
      grid-template-rows: 180px auto;
      gap: 12px;
      padding: 10px;
    }

    .article-cover {
      grid-row: 1;
      min-height: 180px;
    }

    .article-content {
      grid-row: 2;
      padding: 4px 6px 8px;
    }

    .article-title {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-cover img {
      transition: none;
    }
  }
</style>
