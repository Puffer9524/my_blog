---
import type { CollectionEntry } from 'astro:content';
import { postCategoryLabels } from '../config/categories';
import { formatDate } from '../utils/date';
import { getPostSlug } from '../utils/posts';

export interface Props {
  post: CollectionEntry<'posts'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, description, date, category, tags } = post.data;
const slug = getPostSlug(post);
const formattedDate = formatDate(date);
---

<article class:list={['article-card', 'card', { compact }]}>
  <a href={`/posts/${slug}`} class="article-link">
    <div class="article-meta">
      <time class="article-date" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      {category && (
        <span class="article-category">
          {postCategoryLabels[category]}
        </span>
      )}
    </div>

    <h2 class="article-title">{title}</h2>

    {description && (
      <p class="article-desc">{description}</p>
    )}

    {tags.length > 0 && (
      <div class="article-tags">
        {tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}
  </a>
</article>

<style>
  .article-card {
    padding: 0;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .article-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }

  .article-link {
    display: block;
    padding: 22px 24px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .article-date {
    color: var(--color-text-muted);
  }

  .article-category {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 2px 10px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 500;
  }

  .article-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 6px;
    transition: color 0.2s;
  }

  .article-card:hover .article-title {
    color: var(--color-accent);
  }

  .article-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 12px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .tag:hover {
    color: var(--color-text-secondary);
  }

  .article-card.compact {
    height: 100%;
  }

  .compact .article-link {
    height: 100%;
    padding: 14px;
  }

  .compact .article-meta {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 10px;
    font-size: 11px;
  }

  .compact .article-category {
    padding: 1px 7px;
    font-size: 10px;
  }

  .compact .article-title {
    font-size: 14px;
    margin-bottom: 6px;
  }

  .compact .article-desc {
    font-size: 11px;
    line-height: 1.5;
    margin-bottom: 9px;
  }

  .compact .article-tags {
    gap: 4px;
  }

  .compact .tag {
    font-size: 10px;
  }
</style>
