---
// Theme dropdown: dark / light / system
// Uses class-based selectors to support multiple instances on the same page
---

<div class="theme-dropdown">
  <button class="theme-trigger" aria-label="切换主题" title="切换主题">
    <span class="theme-icon" aria-hidden="true">
      <svg class="mode-icon mode-light" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
      </svg>
      <svg class="mode-icon mode-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z" />
      </svg>
      <svg class="mode-icon mode-system" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </svg>
    </span>
    <svg class="theme-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="m4 6 4 4 4-4" />
    </svg>
  </button>

  <ul class="theme-menu" role="menu">
    <li>
      <button class="theme-option" data-theme="light" role="menuitem">
        <svg class="option-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
        </svg>
        <span>浅色模式</span>
        <svg class="check" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>
      </button>
    </li>
    <li>
      <button class="theme-option" data-theme="dark" role="menuitem">
        <svg class="option-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z" />
        </svg>
        <span>深色模式</span>
        <svg class="check" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>
      </button>
    </li>
    <li>
      <button class="theme-option" data-theme="system" role="menuitem">
        <svg class="option-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <rect x="3" y="4" width="18" height="13" rx="2" />
          <path d="M8 21h8M12 17v4" />
        </svg>
        <span>跟随系统</span>
        <svg class="check" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>
      </button>
    </li>
  </ul>
</div>

<style>
  .theme-dropdown {
    position: relative;
    flex-shrink: 0;
  }

  .theme-trigger {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 8px;
    border: none;
    border-radius: 50px;
    background: none;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    transition: background-color 0.2s;
  }

  .theme-trigger:hover {
    background-color: var(--color-bg-hover);
  }

  .theme-icon {
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    color: var(--color-text-secondary);
  }

  .mode-icon {
    display: none;
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-dropdown[data-mode='light'] .mode-light,
  .theme-dropdown[data-mode='dark'] .mode-dark,
  .theme-dropdown[data-mode='system'] .mode-system {
    display: block;
  }

  .theme-arrow {
    width: 12px;
    height: 12px;
    color: var(--color-text-muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .theme-dropdown.open .theme-arrow {
    transform: rotate(180deg);
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 150px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover);
    padding: 6px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 200;
  }

  .theme-dropdown.open .theme-menu {
    display: flex;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: background-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .theme-option:hover {
    background-color: var(--color-bg-hover);
    color: var(--color-text);
  }

  .theme-option .check {
    margin-left: auto;
    width: 15px;
    height: 15px;
    color: var(--color-accent);
    display: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-option.active .check {
    display: inline;
  }

  .theme-option.active {
    color: var(--color-text);
    font-weight: 500;
  }

  .option-icon {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  (function () {
    function getThemeMode(): string {
      return localStorage.getItem('theme-mode') || 'system';
    }

    function getResolvedTheme(): string {
      const mode = getThemeMode();
      if (mode === 'system') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      return mode;
    }

    function applyTheme() {
      const mode = getThemeMode();
      document.documentElement.setAttribute('data-theme-mode', mode);
      document.documentElement.setAttribute('data-theme', getResolvedTheme());
      updateAllUI();
    }

    function setTheme(mode: string) {
      localStorage.setItem('theme-mode', mode);
      applyTheme();
    }

    function updateAllUI() {
      const mode = getThemeMode();
      document.querySelectorAll('.theme-dropdown').forEach((dropdown) => {
        (dropdown as HTMLElement).dataset.mode = mode;

        dropdown.querySelectorAll('.theme-option').forEach((btn) => {
          const val = (btn as HTMLElement).dataset.theme;
          btn.classList.toggle('active', val === mode);
        });
      });
    }

    // Init
    applyTheme();

    // Listen for system changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getThemeMode() === 'system') applyTheme();
    });

    // Wire up all toggle instances
    document.querySelectorAll('.theme-dropdown').forEach((dropdown) => {
      const trigger = dropdown.querySelector('.theme-trigger');
      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        // Close other open dropdowns
        document.querySelectorAll('.theme-dropdown.open').forEach((d) => {
          if (d !== dropdown) d.classList.remove('open');
        });
        dropdown.classList.toggle('open');
      });

      dropdown.querySelectorAll('.theme-option').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const mode = (btn as HTMLElement).dataset.theme;
          if (mode) setTheme(mode);
          dropdown.classList.remove('open');
        });
      });
    });

    // Close all on outside click
    document.addEventListener('click', () => {
      document.querySelectorAll('.theme-dropdown.open').forEach((d) => d.classList.remove('open'));
    });
  })();
</script>
