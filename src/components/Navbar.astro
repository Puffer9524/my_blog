---
import ThemeToggle from './ThemeToggle.astro';
import NavigationIcon from './NavigationIcon.astro';
import { navigation } from '../config/navigation';
import { siteConfig } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: (typeof navigation)[number]['href']) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.name} 主页`}>
      <span class="brand-mark" aria-hidden="true">P</span>
      <span class="brand-name">{siteConfig.name}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-links" aria-label="Main navigation">
      {navigation.map((link) => (
        <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          <NavigationIcon href={link.href} />
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <button class="search-trigger" type="button" aria-label="搜索本站" aria-haspopup="dialog" aria-controls="site-search" title="搜索本站（Ctrl / ⌘ K）" data-search-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" stroke-width="1.6" />
          <path d="m16 16 4.5 4.5" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <div class="desktop-theme">
        <ThemeToggle />
      </div>

      <!-- Hamburger button (visible on mobile) -->
      <button class="hamburger" id="hamburger" aria-label="菜单" aria-expanded="false">
        <span class="hamburger-line" />
        <span class="hamburger-line" />
        <span class="hamburger-line" />
      </button>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navigation.map((link) => (
        <a href={link.href} class:list={['mobile-link', { active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          <span class="mobile-link-icon"><NavigationIcon href={link.href} /></span>
          <span>{link.label}</span>
          <svg class="mobile-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="m7 4 6 6-6 6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </nav>
    <div class="mobile-theme">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: auto;
    max-width: calc(var(--content-max-width) - 32px);
    background: color-mix(in srgb, var(--color-bg-card) 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
    border-radius: 50px;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.1), 0 1px 3px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.2s,
                border-radius 0.25s;
    will-change: transform, opacity;
  }

  .navbar.hidden {
    transform: translateX(-50%) translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .navbar.menu-open {
    border-radius: 24px;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.5px;
    padding: 4px 12px 4px 4px;
    border-radius: 50px;
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .brand:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .brand-mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 10px;
    background: linear-gradient(145deg, var(--color-accent), var(--color-accent-hover));
    color: #fff;
    font-size: 17px;
    line-height: 1;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  /* ===== Desktop nav links ===== */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px;
    border-radius: 50px;
    background: color-mix(in srgb, var(--color-bg-hover) 72%, transparent);
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 6px 12px;
    border-radius: 50px;
    font-size: 14px;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-bg-card);
    transform: translateY(-1px);
  }

  .nav-link.active {
    color: var(--color-accent);
    background-color: var(--color-bg-card);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    font-weight: 600;
  }

  .nav-link:focus-visible,
  .brand:focus-visible,
  .search-trigger:focus-visible,
  .hamburger:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    outline-offset: 2px;
  }

  /* ===== Actions ===== */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .search-trigger {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .search-trigger:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .desktop-theme {
    display: contents;
  }

  /* ===== Hamburger ===== */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 8px;
    border: none;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .hamburger:hover {
    background-color: var(--color-bg-hover);
  }

  .hamburger-line {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-text);
    transition: transform 0.25s, opacity 0.25s;
  }

  /* Hamburger → X animation */
  .menu-open .hamburger .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-open .hamburger .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .menu-open .hamburger .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ===== Mobile dropdown menu ===== */
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 4px 10px 12px;
  }

  .menu-open .mobile-menu {
    display: flex;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    font-size: 15px;
    color: var(--color-text-secondary);
    transition: background-color 0.15s, color 0.15s;
  }

  .mobile-link:hover {
    background-color: var(--color-bg-hover);
    color: var(--color-text);
  }

  .mobile-link.active {
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    font-weight: 500;
  }

  .mobile-link-icon {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 9px;
    background: var(--color-bg-hover);
    color: var(--color-text-secondary);
  }

  .mobile-link.active .mobile-link-icon {
    color: #fff;
    background: var(--color-accent);
  }

  .mobile-arrow {
    width: 16px;
    height: 16px;
    margin-left: auto;
    color: var(--color-text-muted);
  }

  .mobile-theme {
    padding-top: 6px;
    border-top: 1px solid var(--color-divider);
    display: flex;
    justify-content: center;
  }

  .mobile-theme :global(.theme-dropdown) {
    width: 100%;
  }

  /* ===== Responsive ===== */
  @media (max-width: 720px) {
    .navbar {
      top: 10px;
      width: calc(100% - 20px);
      max-width: 420px;
      border-radius: 28px;
    }

    .navbar.menu-open {
      border-radius: 20px;
    }

    .navbar-inner {
      justify-content: space-between;
      gap: 4px;
      padding: 5px;
    }

    .brand {
      font-size: 15px;
      padding: 3px 8px 3px 3px;
    }

    .brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      font-size: 16px;
    }

    /* Hide desktop nav, show hamburger */
    .nav-links {
      display: none;
    }

    .desktop-theme {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .search-trigger { width: 44px; height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .brand,
    .nav-link,
    .hamburger-line {
      transition: none;
    }
  }
</style>

<script>
  // --- Scroll behavior ---
  let lastScrollY = window.scrollY;
  const navbar = document.getElementById('navbar');
  let ticking = false;

  function updateNavbar() {
    const currentScrollY = window.scrollY;
    if (currentScrollY < 60) {
      navbar?.classList.remove('hidden');
    } else if (currentScrollY > lastScrollY && currentScrollY > 100) {
      navbar?.classList.add('hidden');
      // Close menu when hiding
      navbar?.classList.remove('menu-open');
      const hamburger = document.getElementById('hamburger');
      if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    } else if (currentScrollY < lastScrollY) {
      navbar?.classList.remove('hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateNavbar);
      ticking = true;
    }
  }, { passive: true });

  // --- Mobile menu toggle ---
  const hamburger = document.getElementById('hamburger');
  hamburger?.addEventListener('click', () => {
    const isOpen = navbar?.classList.toggle('menu-open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  // Close menu on link click
  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      navbar?.classList.remove('menu-open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close menu on outside click
  document.addEventListener('click', (e) => {
    if (!navbar?.contains(e.target as Node)) {
      navbar?.classList.remove('menu-open');
      hamburger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
