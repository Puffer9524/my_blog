---
import type { CollectionEntry } from 'astro:content';
import { formatMonthDay } from '../utils/date';
import { getPostSlug } from '../utils/posts';

export interface Props {
  posts: CollectionEntry<'posts'>[];
  emptyMessage?: string;
}

const { posts, emptyMessage = '还没有文章。' } = Astro.props;
const groupedByYear = new Map<number, CollectionEntry<'posts'>[]>();

for (const post of posts) {
  const year = post.data.date.getFullYear();
  const yearPosts = groupedByYear.get(year) ?? [];
  yearPosts.push(post);
  groupedByYear.set(year, yearPosts);
}

const years = Array.from(groupedByYear.keys()).sort((a, b) => b - a);
---

{
  posts.length > 0 ? (
    <div class="timeline">
      {years.map((year) => (
        <section class="timeline-year">
          <h2 class="year-heading">{year}</h2>

          <ul class="timeline-list">
            {groupedByYear.get(year)!.map((post) => (
              <li class="timeline-item">
                <time
                  class="timeline-date"
                  datetime={post.data.date.toISOString()}
                >
                  {formatMonthDay(post.data.date)}
                </time>
                <span class="timeline-dot" aria-hidden="true" />
                <a href={`/posts/${getPostSlug(post)}`} class="timeline-title">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="timeline-empty">{emptyMessage}</p>
  )
}

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .year-heading {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 12px;
    padding-left: 8px;
    border-left: 3px solid var(--color-accent);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s;
  }

  .timeline-item:hover {
    background-color: var(--color-bg-hover);
  }

  .timeline-date {
    flex-shrink: 0;
    width: 56px;
    font-size: 13px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .timeline-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    margin-top: 6px;
  }

  .timeline-item:hover .timeline-dot {
    background: var(--color-accent);
  }

  .timeline-title {
    font-size: 15px;
    color: var(--color-text-secondary);
    transition: color 0.15s;
    line-height: 1.4;
  }

  .timeline-title:hover {
    color: var(--color-accent);
  }

  .timeline-empty {
    color: var(--color-text-muted);
    font-size: 14px;
    padding: 12px 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .timeline-item {
      gap: 8px;
      padding: 6px 4px;
    }

    .timeline-date {
      width: 44px;
      font-size: 12px;
    }

    .timeline-title {
      font-size: 14px;
    }
  }
</style>
