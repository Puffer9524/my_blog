---
import type { CollectionEntry } from 'astro:content';
import { lifeCategoryLabels } from '../../config/categories';

export interface Props {
  item: CollectionEntry<'life'>;
}

const { item } = Astro.props;
const { title, description, image, category, link } = item.data;
---

<article class="media-card card" id={`life-${item.slug}`} data-category={category}>
  <div class="media-image-wrapper">
    <img
      src={image}
      alt={title}
      class="media-image"
      loading="lazy"
      width="400"
      height="400"
    />
    <div class="media-overlay">
      <button
        class="zoom-btn"
        data-lightbox-src={image}
        data-lightbox-title={title}
        aria-label={`放大查看 ${title}`}
      >
        🔍
      </button>
      {link && (
        <a
          href={link}
          class="zoom-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`打开 ${title} 链接`}
        >
          🔗
        </a>
      )}
    </div>
  </div>
  <div class="media-body">
    <span class="media-category">{lifeCategoryLabels[category]}</span>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .media-card {
    padding: 0;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .media-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .media-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg);
  }

  .media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .media-card:hover .media-image {
    transform: scale(1.05);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .media-card:hover .media-overlay,
  .media-card:focus-within .media-overlay {
    opacity: 1;
  }

  .zoom-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    font-size: 16px;
    color: inherit;
    transition: transform 0.2s;
  }

  .zoom-btn:hover {
    transform: scale(1.1);
  }

  .media-body {
    padding: 9px 10px 11px;
  }

  .media-category {
    display: inline-block;
    margin-bottom: 2px;
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  h3 {
    margin-bottom: 3px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 11px;
    line-height: 1.5;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
