---
import {
  FEATURED_LIFE_CATEGORY_SLUGS,
  lifeCategoryLabels,
} from '../../config/categories';
import LifeCategoryIcon from './LifeCategoryIcon.astro';

const activeCategory = FEATURED_LIFE_CATEGORY_SLUGS[0];
---

<nav class="life-nav card" aria-label="生活分类" data-life-navigation>
  {FEATURED_LIFE_CATEGORY_SLUGS.map((category) => (
    <button
      class:list={['life-nav-item', { active: category === activeCategory }]}
      type="button"
      data-category={category}
      aria-pressed={category === activeCategory ? 'true' : 'false'}
    >
      <span class="icon-shell">
        <LifeCategoryIcon category={category} />
      </span>
      <span class="nav-label">{lifeCategoryLabels[category]}</span>
    </button>
  ))}
</nav>

<style>
  .life-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 18px;
  }

  .life-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 0;
    min-height: 54px;
    padding: 7px 14px;
    border: 1px solid transparent;
    border-radius: 13px;
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .icon-shell {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--color-bg-hover);
    color: var(--color-text-secondary);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .life-nav-item:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
    transform: translateY(-1px);
  }

  .life-nav-item:hover .icon-shell {
    color: var(--color-accent);
    background: var(--color-bg-card);
    transform: scale(1.04);
  }

  .life-nav-item:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 24%, transparent);
  }

  .life-nav-item.active {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-card));
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .life-nav-item.active .icon-shell {
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 4px 10px color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  @media (max-width: 640px) {
    .life-nav {
      display: flex;
      overflow-x: auto;
      padding: 7px;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .life-nav::-webkit-scrollbar {
      display: none;
    }

    .life-nav-item {
      flex: 0 0 auto;
      min-width: 112px;
      min-height: 50px;
      padding: 6px 12px;
      scroll-snap-align: start;
    }

    .icon-shell {
      width: 32px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .life-nav-item,
    .icon-shell {
      transition: none;
    }
  }
</style>

<script>
  const navigation = document.querySelector<HTMLElement>('[data-life-navigation]');
  const navItems = navigation?.querySelectorAll<HTMLButtonElement>('.life-nav-item');
  const sections = document.querySelectorAll<HTMLElement>('[data-life-section]');

  function selectCategory(category: string | undefined) {
    if (!Array.from(sections).some((section) => section.dataset.category === category)) return;
    navItems?.forEach((item) => {
      const active = item.dataset.category === category;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    sections.forEach((section) => {
      section.classList.toggle('hidden', section.dataset.category !== category);
    });
  }

  function restoreLocation() {
    let target: HTMLElement | null = null;
    try { target = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { /* Ignore malformed hashes. */ }
    const category = target?.closest<HTMLElement>('[data-life-section]')?.dataset.category
      ?? new URLSearchParams(location.search).get('category')
      ?? navItems?.[0]?.dataset.category;
    selectCategory(category);
    if (target) requestAnimationFrame(() => target.scrollIntoView({ block: 'center' }));
  }

  navItems?.forEach((item) => item.addEventListener('click', () => {
    const category = item.dataset.category;
    selectCategory(category);
    const url = new URL(location.href);
    url.searchParams.set('category', category ?? '');
    url.hash = '';
    history.replaceState(null, '', url);
  }));

  window.addEventListener('popstate', restoreLocation);
  window.addEventListener('hashchange', restoreLocation);
  restoreLocation();
</script>
