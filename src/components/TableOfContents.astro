---
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter to only h2 and h3 for a cleaner TOC
const toc = headings.filter(
  (h) => h.depth >= 2 && h.depth <= 3,
);
---

{ toc.length > 0 && (
  <nav class="toc-card card" aria-label="文章目录">
    <h4 class="toc-title">目录</h4>
    <ul class="toc-list">
      {toc.map((heading) => (
        <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`} class="toc-link">
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-card {
    padding: 18px 20px;
  }

  .toc-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--color-text);
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-item {
    line-height: 1.4;
  }

  .toc-depth-3 {
    padding-left: 14px;
  }

  .toc-link {
    display: block;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.15s, background-color 0.15s;
    border-left: 2px solid transparent;
  }

  .toc-link:hover {
    color: var(--color-text);
    background-color: var(--color-bg-hover);
  }

  /* Active state via JS or :target? We'll keep it simple with hover */
</style>

<script>
  // Highlight the current section in the TOC as the user scrolls
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length === 0) {
    // No TOC on this page
  }

  const headingElements = Array.from(
    document.querySelectorAll('.prose h2[id], .prose h3[id]')
  );

  function updateActiveLink() {
    let currentId = '';
    for (const el of headingElements) {
      if (el.getBoundingClientRect().top <= 120) {
        currentId = el.id;
      } else {
        break;
      }
    }

    tocLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isActive = href === `#${currentId}`;
      link.classList.toggle('toc-active', isActive);
    });
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveLink();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Initial
  updateActiveLink();
</script>

<style>
  .toc-link.toc-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
</style>
