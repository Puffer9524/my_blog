<div class="image-lightbox" data-image-lightbox aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="关闭图片预览">&times;</button>
  <img class="lightbox-image" src="" alt="" />
  <p class="lightbox-title"></p>
</div>

<style>
  .image-lightbox {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s, visibility 0.25s;
  }

  .image-lightbox.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox-image {
    max-width: 92vw;
    max-height: 82vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-title {
    color: #fff;
    font-size: 14px;
    opacity: 0.82;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    font-size: 28px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .image-lightbox { padding: 12px; }
  }
</style>

<script>
  const lightbox = document.querySelector('[data-image-lightbox]');
  const image = lightbox?.querySelector('.lightbox-image') as HTMLImageElement | null;
  const title = lightbox?.querySelector('.lightbox-title');
  const closeButton = lightbox?.querySelector('.lightbox-close');

  function openLightbox(src: string, label: string) {
    if (!lightbox || !image || !title) return;
    image.src = src;
    image.alt = label;
    title.textContent = label;
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest('[data-lightbox-src]') as HTMLElement | null;
    if (trigger) {
      openLightbox(
        trigger.dataset.lightboxSrc ?? '',
        trigger.dataset.lightboxTitle ?? '',
      );
      return;
    }

    if (target === lightbox || target === closeButton) closeLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('open')) {
      closeLightbox();
    }
  });
</script>
