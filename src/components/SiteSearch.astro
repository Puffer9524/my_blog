<dialog class="site-search" id="site-search" aria-labelledby="search-heading">
  <div class="search-panel">
    <header class="search-header">
      <h2 id="search-heading">搜索本站</h2>
      <button type="button" class="search-close" aria-label="关闭搜索" data-search-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="m6 6 12 12M6 18 18 6" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </header>
    <form class="search-form" role="search">
      <label class="search-label" for="site-search-input">搜索关键词</label>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" stroke-width="1.6" /><path d="m16 16 4.5 4.5" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input id="site-search-input" type="search" placeholder="搜索文章、标签、生活…" autocomplete="off" maxlength="200" aria-controls="search-results" aria-describedby="search-status" autofocus />
    </form>
    <p class="search-status" id="search-status" role="status">输入关键词，搜索文章全文与生活记录。</p>
    <button type="button" class="search-retry" data-search-retry hidden>重新加载</button>
    <ol class="search-results" id="search-results" aria-label="搜索结果"></ol>
    <button type="button" class="search-more" data-search-more hidden>显示更多结果</button>
    <footer class="search-footer"><span>Enter 打开首条 · ↑ ↓ 选择</span><span>Esc 关闭</span></footer>
  </div>
</dialog>

<script>
  import '../scripts/site-search';
</script>

<style>
  .site-search {
    width: min(620px, calc(100% - 32px));
    max-height: min(720px, calc(100dvh - 64px));
    margin: min(12vh, 100px) auto auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-bg-card);
    color: var(--color-text);
    color-scheme: light;
    box-shadow: 0 16px 60px rgb(0 0 0 / 18%);
    overflow: hidden;
    overscroll-behavior: contain;
  }

  :global([data-theme='dark']) .site-search { background: #161619; color-scheme: dark; }
  .site-search::backdrop { background: rgb(0 0 0 / 48%); }
  .search-panel { display: flex; flex-direction: column; max-height: inherit; padding: 22px; }
  .search-header,
  .search-form,
  .search-status,
  .search-footer,
  .search-more,
  .search-retry { flex-shrink: 0; }

  .search-header,
  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .search-header h2 { font-size: 16px; font-weight: 600; }
  .search-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .search-close:hover { background: var(--color-bg-hover); }
  .search-form {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--color-text-secondary);
  }

  .search-form:focus-within { border-color: var(--color-accent); }
  .search-form svg { flex: 0 0 auto; }
  .search-form input {
    width: 100%;
    min-width: 0;
    padding: 13px 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 16px;
  }

  .search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .search-status { margin: 14px 0 8px; color: var(--color-text-secondary); font-size: 13px; }
  .search-results { display: flex; flex-direction: column; gap: 4px; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--color-border) transparent; }
  .search-results :global(a) { display: block; padding: 12px; border-radius: 9px; overflow-wrap: anywhere; }
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) { background: var(--color-bg-hover); }
  .search-results :global(.result-meta) { font-size: 11px; color: var(--color-text-secondary); margin-bottom: 3px; }
  .search-results :global(h3) { font-size: 15px; font-weight: 600; line-height: 1.5; }
  .search-results :global(.result-excerpt) { margin-top: 5px; font-size: 13px; color: var(--color-text-secondary); line-height: 1.65; }
  .search-results :global(mark) { color: inherit; background: color-mix(in srgb, var(--color-accent) 18%, transparent); border-radius: 2px; }
  .search-footer { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--color-border); color: var(--color-text-secondary); font-size: 11px; }
  .search-more,
  .search-retry { margin-top: 10px; padding: 7px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-text-secondary); font: inherit; font-size: 13px; cursor: pointer; }
  .site-search :global(a:focus-visible),
  .site-search button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  @media (max-width: 640px) {
    .site-search { width: calc(100% - 20px); margin-top: 16px; max-height: calc(100dvh - 32px); border-radius: 14px; }
    .search-panel { padding: 16px; }
    .search-close { width: 44px; height: 44px; }
  }
</style>
