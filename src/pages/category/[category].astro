---
import PostTimeline from '../../components/PostTimeline.astro';
import {
  postCategories,
  type PostCategory,
} from '../../config/categories';
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return postCategories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category.slug),
    },
  }));
}

interface Props {
  category: {
    slug: PostCategory;
    label: string;
  };
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { category, posts } = Astro.props as Props;
---

<Layout
  title={category.label}
  description={`${category.label}分类下的文章`}
>
  <div class="card category-card">
    <h1>{category.label}</h1>
    <p>共 {posts.length} 篇文章</p>
    <PostTimeline posts={posts} emptyMessage="这个分类还没有文章。" />
  </div>
</Layout>

<style>
  .category-card {
    padding: 28px 32px;
  }

  .category-card h1 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .category-card > p {
    color: var(--color-text-muted);
    font-size: 13px;
    margin-bottom: 28px;
  }

  @media (max-width: 768px) {
    .category-card {
      padding: 18px;
    }
  }
</style>
