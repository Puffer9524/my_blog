---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PhotoAlbum from '../components/PhotoAlbum.astro';
import {
  FEATURED_LIFE_CATEGORY_SLUGS,
  lifeCategoryLabels,
  lifePostTagAliases,
} from '../config/categories';
import { getPublishedPosts } from '../utils/posts';

const items = await getCollection('life');
const sortedItems = items.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const posts = await getPublishedPosts();

function postMatchesCategory(
  tags: string[],
  category: (typeof FEATURED_LIFE_CATEGORY_SLUGS)[number],
) {
  const normalizedTags = tags.map((tag) => tag.toLocaleLowerCase());
  return lifePostTagAliases[category].some((alias) =>
    normalizedTags.includes(alias.toLocaleLowerCase()),
  );
}

---

<Layout title="生活">
  <div class="life-page">
    <nav class="life-nav card" aria-label="生活分类">
      {FEATURED_LIFE_CATEGORY_SLUGS.map((category, index) => (
        <button
          class:list={['life-nav-item', { active: index === 0 }]}
          type="button"
          data-category={category}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {lifeCategoryLabels[category]}
        </button>
      ))}
    </nav>

    {FEATURED_LIFE_CATEGORY_SLUGS.map((category) => {
      const categoryItems = sortedItems.filter(
        (item) => item.data.category === category,
      );
      const categoryPosts = posts.filter((post) =>
        postMatchesCategory(post.data.tags, category),
      );

      return (
        <section
          class:list={['life-section', { hidden: category !== FEATURED_LIFE_CATEGORY_SLUGS[0] }]}
          data-category={category}
        >
          <header class="section-header">
            <h2>{lifeCategoryLabels[category]}</h2>
            <span>{categoryItems.length + categoryPosts.length} 项</span>
          </header>

          <div class:list={['gallery', { 'photo-gallery': category === 'photography' }]}>
          {categoryItems.map((item) => {
              if (category === 'photography') {
                return <PhotoAlbum album={item} />;
              }

              const { title, description, image, link } = item.data;
              return (
                <article class="gallery-card card" data-category={category}>
                  <div class="card-image-wrapper">
                    <img
                      src={image}
                      alt={title}
                      class="card-image"
                      loading="lazy"
                      width="400"
                      height="400"
                    />
                    <div class="card-image-overlay">
                      <button
                        class="zoom-btn"
                        data-full={image}
                        data-title={title}
                        aria-label={`放大查看 ${title}`}
                      >
                        🔍
                      </button>
                      {link && (
                        <a
                          href={link}
                          class="zoom-btn"
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`打开 ${title} 链接`}
                        >
                          🔗
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="card-body">
                    <span class="card-cat">{lifeCategoryLabels[category]}</span>
                    <h3 class="card-title">{title}</h3>
                    {description && <p class="card-desc">{description}</p>}
                  </div>
                </article>
              );
            })}

          </div>

          {categoryPosts.length > 0 && (
            <div class="related-posts">
              <h3>相关文章</h3>
              <div class="related-post-list">
                {categoryPosts.map((post) => (
                  <ArticleCard post={post} />
                ))}
              </div>
            </div>
          )}
        </section>
      );
    })}
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="关闭">&times;</button>
    <img class="lightbox-image" id="lightbox-image" src="" alt="" />
    <p class="lightbox-title" id="lightbox-title"></p>
  </div>
</Layout>

<style>
  .life-page {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .life-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
  }

  .life-nav-item {
    padding: 6px 16px;
    border: 1px solid var(--color-border);
    border-radius: 50px;
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .life-nav-item:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
  }

  .life-nav-item.active {
    color: #fff;
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .life-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .life-section.hidden {
    display: none;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
  }

  .section-header h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
  }

  .section-header span {
    color: var(--color-text-muted);
    font-size: 12px;
  }

  /* ===== Gallery grid ===== */
  .gallery {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .gallery-card {
    padding: 0;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .gallery-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .gallery-card.hidden {
    display: none;
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg);
  }

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .related-posts h3 {
    padding-left: 4px;
    color: var(--color-text-secondary);
    font-size: 14px;
    font-weight: 600;
  }

  .related-post-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .gallery-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .gallery-card:hover .card-image-overlay {
    opacity: 1;
  }

  .zoom-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    font-size: 16px;
    text-decoration: none;
    transition: transform 0.2s;
    color: inherit;
  }

  .zoom-btn:hover {
    transform: scale(1.1);
  }

  .card-body {
    padding: 9px 10px 11px;
  }

  .card-cat {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .card-title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 3px;
  }

  .card-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== Lightbox ===== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    backdrop-filter: blur(8px);
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 28px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox-image {
    max-width: 85vw;
    max-height: 70vh;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
  }

  .lightbox-title {
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    opacity: 0.8;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1200px) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .life-nav {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .life-nav::-webkit-scrollbar {
      display: none;
    }

    .life-nav-item {
      flex: 0 0 auto;
    }

    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .life-page {
      gap: 22px;
    }
  }

  @media (max-width: 380px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const lifeNavItems = document.querySelectorAll('.life-nav-item');
  const lifeSections = document.querySelectorAll('.life-section');

  lifeNavItems.forEach((item) => {
    item.addEventListener('click', () => {
      const category = (item as HTMLElement).dataset.category;

      lifeNavItems.forEach((navItem) => {
        const active = navItem === item;
        navItem.classList.toggle('active', active);
        navItem.setAttribute('aria-pressed', String(active));
      });

      lifeSections.forEach((section) => {
        const matches = (section as HTMLElement).dataset.category === category;
        section.classList.toggle('hidden', !matches);
      });
    });
  });

  // --- Lightbox ---
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string, title: string) {
    if (lightboxImage && lightboxTitle && lightbox) {
      lightboxImage.src = src;
      lightboxImage.alt = title;
      lightboxTitle.textContent = title;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Delegate zoom button clicks
  document.querySelector('.life-page')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const albumMainButton = target.closest('.album-main-button') as HTMLElement;
    if (albumMainButton) {
      const src = albumMainButton.dataset.full;
      const title = albumMainButton.dataset.title;
      if (src && title) openLightbox(src, title);
      return;
    }

    const zoomBtn = target.closest('.zoom-btn') as HTMLElement;
    if (!zoomBtn) return;

    // Only handle 🔍 zoom buttons (not 🔗 links)
    if (zoomBtn.tagName === 'A') return;

    const src = zoomBtn.dataset.full;
    const title = zoomBtn.dataset.title;
    if (src && title) openLightbox(src, title);
  });

  lightboxClose?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
