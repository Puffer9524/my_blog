---
import LifeNavigation from '../components/life/LifeNavigation.astro';
import LifeSection from '../components/life/LifeSection.astro';
import Layout from '../layouts/Layout.astro';
import { getLifeSections } from '../utils/life';

const sections = await getLifeSections();
---

<Layout title="生活">
  <div class="life-page">
    <LifeNavigation />
    {sections.map((section, index) => (
      <LifeSection {...section} active={index === 0} />
    ))}
  </div>
</Layout>

<style>
  .life-page {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (max-width: 640px) {
    .life-page {
      gap: 22px;
    }
  }
</style>
