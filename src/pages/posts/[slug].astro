---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { postCategoryLabels } from '../../config/categories';
import { formatDate } from '../../utils/date';
import { getPostSlug, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .map((post) => ({
      params: { slug: getPostSlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, date, category, tags } = post.data;

const formattedDate = formatDate(date);
---

<Layout title={title} description={description}>
  <article class="card article-full">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {category && (
          <span class="article-category">
            {postCategoryLabels[category]}
          </span>
        )}
      </div>

      <h1 class="article-title">{title}</h1>

      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <div slot="right-sidebar">
    <TableOfContents headings={headings} />
  </div>
</Layout>

<style>
  .article-full {
    padding: 32px 36px;
  }

  .article-header {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-divider);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9em;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .article-meta time {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .article-category {
    background: var(--color-accent);
    color: #fff;
    padding: 2px 12px;
    border-radius: 20px;
    font-size: 0.82em;
    font-weight: 500;
  }

  .article-title {
    font-size: 1.75em;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: 14px;
    letter-spacing: 0.02em;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    font-size: 0.82em;
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: 2px 10px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    transition: color 0.2s, border-color 0.2s;
    cursor: default;
  }

  .tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .article-full {
      padding: 20px 18px;
    }

    .article-title {
      font-size: 1.4em;
    }
  }
</style>
