---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { postCategoryLabels } from '../../config/categories';
import { formatDate } from '../../utils/date';
import { getPostSlug, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .map((post) => ({
      params: { slug: getPostSlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, date, category, tags } = post.data;

const formattedDate = formatDate(date);
---

<Layout title={title} description={description}>
  <article class="card article-full">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {category && (
          <span class="article-category">
            {postCategoryLabels[category]}
          </span>
        )}
      </div>

      <h1 class="article-title">{title}</h1>

      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <div slot="right-sidebar">
    <TableOfContents headings={headings} />
  </div>
</Layout>
