---
import Layout from '../layouts/Layout.astro';
import { friends } from '../data/friends';
---

<Layout title="友链">
  <div class="friends-page">
    <div class="card friends-header">
      <h1 class="friends-title">友链</h1>
      <p class="friends-desc">这里记录一些常看常逛的地方。</p>
    </div>

    {
      friends.length === 0 ? (
        <div class="card friends-empty">
          <p>🚧 还没有友链，欢迎来交换～</p>
        </div>
      ) : (
        <div class="friends-grid">
          {friends.map((f) => (
            <a
              href={f.url}
              class="friend-card card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="friend-avatar">
                {f.avatar ? (
                  <img src={f.avatar} alt={f.name} width="48" height="48" loading="lazy" />
                ) : (
                  <span class="avatar-placeholder">{f.name[0]}</span>
                )}
              </div>
              <div class="friend-info">
                <h3 class="friend-name">{f.name}</h3>
                <p class="friend-desc">{f.description}</p>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .friends-page {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .friends-header {
    padding: 20px 24px;
  }

  .friends-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .friends-desc {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .friends-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: 32px 24px;
    font-size: 14px;
  }

  .friends-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .friend-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }

  .friend-avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
  }

  .friend-avatar img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-bg);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .friend-info {
    flex: 1;
    min-width: 0;
  }

  .friend-name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .friend-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
