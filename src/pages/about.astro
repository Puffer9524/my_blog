---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const about = await getEntry('about', 'profile');

if (!about) {
  throw new Error('缺少关于页面内容：src/content/about/profile.md');
}

const { Content } = await about.render();
---

<Layout title={about.data.title} description={about.data.description}>
  <div class="card about-card">
    <h1 class="about-title">{about.data.title}</h1>
    <div class="prose about-content">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .about-card {
    padding: 32px 36px;
  }

  .about-title {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .about-content :global(h2) {
    font-size: 1.2em;
  }

  @media (max-width: 768px) {
    .about-card {
      padding: 18px;
    }
  }
</style>
